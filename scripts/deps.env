# Pinned upstream commits for external dependencies.
# Sourced by both the Makefile (gvsoc_init) and .gitlab-ci.yml (clone_magia).
# Format is KEY=VALUE with no spaces so it is valid for both `make include`
# and POSIX `source`.

# https://github.com/FondazioneChipsIT/MAGIA.git - cc/collective-rebase on 2026-09-15
MAGIA_COMMIT=b8c312b592efedc5d212644f038038d31cff8886

# github.com/FondazioneChipsIT/gvsoc - main on 2026-10-09
GVSOC_COMMIT=93cedc4cb2970a28ff38aef4393d8d69eae503a4

# github.com/FrancescoConti/gvsoc-core - fc/spatz-scaling on 2026-10-27
# (gvsoc-core main on 2026-10-09, in-order chaining commit of the Spatz VLSU, needed at 16 lanes)
GVSOC_CORE_REPO=https://github.com/FrancescoConti/gvsoc-core.git
GVSOC_CORE_COMMIT=dd44f2bf760e793d1ee373cd5d723fd40942c3b9

# github.com/FrancescoConti/gvsoc-pulp - fc/spatz-scaling on 2026-10-27
# (light_redmule_v2 MATMUL, magia_v3 ELF loader straight to the L2, configurable L2 size,
# magia_v3 Spatz with VLEN 256 and 1 IPU as in the RTL, spatz_vlen, spatz_nb_lanes, redmule_h
# and redmule_w target parameters)
GVSOC_PULP_REPO=https://github.com/FrancescoConti/gvsoc-pulp.git
GVSOC_PULP_COMMIT=a4c774eba134a65c2ab60e9712052130db8d7f10

# github.com/gvsoc/gvsoc-engine - main on 2026-10-09
GVSOC_ENGINE_COMMIT=4e8feaf8d0a39622c3f8ceb01e1fd808911cd066

# github.com/gvsoc/gvrun - main on 2026-10-09
GVSOC_GVRUN_COMMIT=5b27896d5051be1a13a6f92b3f12bcf9c88b9360
